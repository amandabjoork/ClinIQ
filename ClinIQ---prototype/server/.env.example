#
# Enklast: skapa ett gratiskonto på https://neon.tech, skapa ett projekt,
# och kopiera "Connection string" därifrån (den ser ut ungefär så här):
#DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Kör du istället Postgres lokalt via Docker (se docker-compose.yml), använd:
DATABASE_URL="postgresql://cliniq:cliniq@localhost:5432/cliniq?schema=public"

PORT=4000
